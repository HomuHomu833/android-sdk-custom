// Overlays load after every Android.bp; paths are the repo's, or a fetched
// project's when they start with its AOSP path. amend merges onto a module
// (target_alias copies target sections), sdk_tools lists the tools, any other
// type replaces its namesake. target: also takes bsd/freebsd/netbsd/openbsd.

// What an AOSP source build of the platform sets. ART only enables its host
// tools (dexdump) when it is built from source.
soong_config_values {
    art_module: {
        source_build: true,
    },
}

// Every binary the official packages ship, from 29 on (make-sdk.sh swaps
// ours in by name and drops any it lacks). Releases without a module skip it
// (casefold arrived in 30.0.5); `until` names the first release without them.
sdk_tools {
    name: "build-tools",
    tools: [
        "aapt",
        "aapt2",
        "aidl",
        "dexdump",
        "split-select",
        "zipalign",
    ],
}

sdk_tools {
    name: "platform-tools",
    tools: [
        "adb",
        "etc1tool",
        "fastboot",
        "hprof-conv",
        "make_f2fs",
        "make_f2fs_casefold",
        "mke2fs",
        "sqlite3",
    ],
}

sdk_tools {
    name: "platform-tools-dmtracedump",
    until: "34.0.5",
    tools: ["dmtracedump"],
}

// Not on Windows, as upstream. Their fs_config comes from libcutils, which
// builds it for every other host until they were retired.
sdk_tools {
    name: "platform-tools-fs",
    until: "34.0.0",
    tools: [
        "e2fsdroid",
        "sload_f2fs",
    ],
    target: {
        windows: {
            exclude_tools: [
                "e2fsdroid",
                "sload_f2fs",
            ],
        },
    },
}

// Flags ahead of every module's own, as cc/config/global.go and *_host.go set
// them, minus debug info, -Werror and Soong-clang specifics. exclude_* here
// strips flags from every module; host_ldlibs go to every binary.
cc_defaults {
    name: "builder_defaults",
    // build.sh's host aprotoc (sdk:host_protoc) only runs our codegen, so it
    // skips optimizing, and with it fortify.
    cflags: select(soong_config_variable("sdk", "host_protoc"), {
        true: ["-O0"],
        default: ["-O2"],
    }) + [
        // commonGlobalCflags
        "-Wall",
        "-Wextra",
        "-Wpointer-arith",
        "-Wno-error=deprecated-declarations",
        "-Wno-c23-extensions",
        "-Wno-c99-designator",
        "-Wno-gnu-folding-constant",
        "-Wno-inconsistent-missing-override",
        "-Wno-reorder-init-list",
        "-Wno-sign-compare",
        "-Wno-unused",
        "-DANDROID",
        "-DNDEBUG",
        "-UDEBUG",
        "-D__compiler_offsetof=__builtin_offsetof",
        "-fcolor-diagnostics",
        "-ffp-contract=off",
        "-fno-exceptions",
        "-fno-strict-aliasing",
        // noOverrideGlobalCflags (the -Wno- half)
        "-Wno-missing-field-initializers",
        "-Wno-packed-non-pod",
        "-Wno-implicit-int-float-conversion",
        "-Wno-tautological-overlap-compare",
        "-Wno-deprecated-copy",
        "-Wno-zero-as-null-pointer-constant",
        "-Wno-deprecated-anon-enum-enum-conversion",
        "-Wno-deprecated-enum-enum-conversion",
        "-Wno-non-c-typedef-for-linkage",
        "-Wno-align-mismatch",
        "-Wno-vla-cxx-extension",
        "-Wno-cast-function-type-mismatch",
        // Our toolchains are older or newer than Soong's clang; unknown -W
        // flags from Android.bp must not end the build.
        "-Wno-unknown-warning-option",
        // 32-bit hosts need 64-bit off_t for lseek (Soong only has 64-bit hosts)
        "-D_FILE_OFFSET_BITS=64",
    ],
    // Warnings that are noise for these builds, triaged from the CI logs of
    // every release (deprecations, style, vendored-C patterns, libc-header
    // false positives; every instance read). The builder appends late_cflags
    // after a module's own C/C++ flags, so its -Wextra/-W<x> cannot re-enable
    // them. Those every compiler raises are here; the rest sit under the
    // target whose compiler raises them. Anything unlisted still shows.
    late_cflags: [
        "-Wno-deprecated-literal-operator",
        "-Wno-deprecated-declarations",
        "-Wno-deprecated-pragma",
        "-Wno-deprecated-redundant-constexpr-static-def",
        "-Wno-defaulted-function-deleted",
        "-Wno-invalid-offsetof",
        "-Wno-range-loop-construct",
        "-Wno-pessimizing-move",
        "-Wno-macro-redefined",
        "-Wno-int-in-bool-context",
    ],
    cppflags: [
        // commonGlobalCppflags
        "-Wimplicit-fallthrough",
        "-D_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS",
        "-Wno-gnu-include-next",
        // A constexpr function that can never be a constant expression is
        // fine since P2448R2, and Soong's clang accepts it in C++20 too; the
        // clang 18 under osxcross still errors on it (androidfw's
        // LocaleDataLookup.h).
        "-Wno-invalid-constexpr",
        // Newer clang errors by default when a member template's parameter
        // shadows the enclosing one; older ART's stl_util.h does that.
        "-Wno-strict-primary-template-shadow",
    ],
    target: {
        // Hardening, as linuxCflags/linuxLdflags and linuxBionicCflags have
        // it (musl ignores _FORTIFY_SOURCE).
        linux: {
            // zig's clang (glibc, musl; bionic's NDK clang raises a subset)
            late_cflags: [
                "-Wno-unnecessary-virtual-specifier",
                "-Wno-nontrivial-memcall",
                "-Wno-character-conversion",
                "-Wno-old-style-cast",
                "-Wno-incompatible-pointer-types-discards-qualifiers",
                "-Wno-typedef-redefinition",
                "-Wno-unterminated-string-initialization",
                "-Wno-gnu-variable-sized-type-not-at-end",
                "-Wno-knr-promoted-parameter",
                "-Wno-array-compare",
                "-Wno-tautological-constant-out-of-range-compare",
                "-Wno-unused-parameter",
                "-Wno-unused-but-set-variable",
                "-Wno-used-but-marked-unused",
                "-Wno-thread-safety-reference-return",
                "-Wno-varargs", // va_start on a promoted enum (hexagon)
            ],
            cflags: select(soong_config_variable("sdk", "host_protoc"), {
                true: [],
                default: [
                    "-U_FORTIFY_SOURCE",
                    "-D_FORTIFY_SOURCE=3",
                ],
            }) + ["-fstack-protector-strong"],
            ldflags: [
                "-Wl,-z,noexecstack",
                "-Wl,-z,relro",
                "-Wl,-z,now",
            ],
        },
        linux_glibc: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
                "-lm",
                "-lrt",
            ],
        },
        linux_musl: {
            cflags: ["-DANDROID_HOST_MUSL"],
            host_ldlibs: [
                "-ldl",
                "-lpthread",
                "-lm",
                "-lrt",
            ],
        },
        linux_bionic: {
            // __ANDROID__ means an Android device; linux_bionic builds are host
            // tools that happen to use bionic. Soong's toolchains leave it
            // undefined (-U__ANDROID__ for x86_64, a plain aarch64-linux triple
            // for arm64); the NDK clang we use defines it.
            cflags: ["-U__ANDROID__"],
            host_ldlibs: [
                "-ldl",
                "-lm",
            ],
        },
        darwin: {
            // osxcross' clang
            late_cflags: [
                "-Wno-old-style-cast",
                "-Wno-unused-parameter",
                "-Wno-thread-safety-reference-return",
                "-Wno-format", // same-width LP64 printf types
                "-Wformat-security",
            ],
            // darwinCflags, plus the fortify level the sqlite build asks for
            // (libSystem has the checked functions)
            cflags: [
                "-fPIC",
                "-fstack-protector-strong",
                "-U_FORTIFY_SOURCE",
                "-D_FORTIFY_SOURCE=3",
            ],
            host_ldlibs: [
                "-lm",
                "-lpthread",
            ],
        },
        windows: {
            // llvm-mingw's clang
            late_cflags: [
                "-Wno-unnecessary-virtual-specifier",
                "-Wno-nontrivial-memcall",
                "-Wno-character-conversion",
                "-Wno-deprecated-attributes",
                "-Wno-zero-as-null-pointer-constant",
                "-Wno-overloaded-virtual",
                "-Wno-reorder-ctor",
                "-Wno-unterminated-string-initialization",
                "-Wno-expansion-to-defined",
                "-Wno-tautological-constant-out-of-range-compare",
                "-Wno-pragma-pack",
                "-Wno-ignored-attributes",
                "-Wno-main",
                "-Wno-unused-parameter",
                "-Wno-unused-but-set-variable",
                "-Wno-unused-command-line-argument",
                "-Wno-format", // 64-bit pid_t/size_t in 8-byte vararg slots
                "-Wformat-security",
                "-Wno-constant-conversion", // INVALID_SOCKET as int
                "-Wno-int-to-void-pointer-cast",
            ],
            // windowsCflags
            cflags: [
                "-DUSE_MINGW",
                "-DWIN32_LEAN_AND_MEAN",
                "-Wno-unused-parameter",
                "-D__STDC_CONSTANT_MACROS",
                "-D__USE_MINGW_ANSI_STDIO=1",
                "-D_WIN32_WINNT=0x0A00",
                "-DWINVER=0x0A00",
                "-mno-ms-bitfields",
                // AdbWinApi is linked in, not a DLL (adbwinapi.bp)
                "-DADBWIN_STATIC",
                // Soong gets these from -lssp; llvm-mingw's CRT implements
                // both and its driver links the stack protector's support.
                "-U_FORTIFY_SOURCE",
                "-D_FORTIFY_SOURCE=3",
                "-fstack-protector-strong",
            ],
            // windowsLdflags
            ldflags: [
                "-Wl,--dynamicbase",
                "-Wl,--nxcompat",
            ],
        },
        windows_x86_64: {
            ldflags: ["-Wl,--high-entropy-va"],
        },
        windows_arm64: {
            ldflags: ["-Wl,--high-entropy-va"],
        },
        bsd: {
            // zig's clang, plus FreeBSD's annotated pthread headers
            late_cflags: [
                "-Wno-unnecessary-virtual-specifier",
                "-Wno-nontrivial-memcall",
                "-Wno-character-conversion",
                "-Wno-old-style-cast",
                "-Wno-char-subscripts",
                "-Wno-unterminated-string-initialization",
                "-Wno-array-compare",
                "-Wno-tautological-constant-out-of-range-compare",
                "-Wno-unused-parameter",
                "-Wno-unused-but-set-variable",
                "-Wno-thread-safety-analysis",
                "-Wno-thread-safety-reference-return",
                "-Wno-format", // same-width printf types
                "-Wformat-security",
                "-Wno-unaligned-access", // packed fields, strict-align OpenBSD aarch64
            ],
            // The Linux hardening minus fortify, which not every BSD libc
            // implements.
            cflags: ["-fstack-protector-strong"],
            ldflags: [
                "-Wl,-z,noexecstack",
                "-Wl,-z,relro",
                "-Wl,-z,now",
            ],
            host_ldlibs: [
                "-lpthread",
                "-lm",
            ],
        },
        // BoringSSL lacks runtime ARM CPU detection on most BSDs (and all
        // before 34.0.5): fix the caps at compile time, as it does itself on
        // OpenBSD arm32. ARM only, as older releases also skip x86 detection.
        bsd_arm: {
            cflags: ["-DOPENSSL_STATIC_ARMCAP"],
        },
        bsd_arm64: {
            cflags: ["-DOPENSSL_STATIC_ARMCAP"],
        },
        // Abseil reads the PowerPC timebase frequency on glibc, Linux, AIX and
        // FreeBSD only (older releases: glibc and FreeBSD) and #errors
        // elsewhere; take its clock_gettime() cycle clock instead. Global, as
        // its headers read the switch too.
        musl_powerpc: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
        musl_powerpc64: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
        musl_powerpc64le: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
        netbsd_powerpc: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
        openbsd_powerpc: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
        openbsd_powerpc64: {
            cflags: ["-DABSL_USE_UNSCALED_CYCLECLOCK=0"],
        },
    },
    // CPUs Soong never built for get none of Android.bp's arch.* sources, but
    // may share another CPU's macros; turn off the code that expects them:
    // BoringSSL asm (asflags too), libpng SIMD, zstd's x86-64 Huffman loop.
    arch: {
        // BoringSSL's ARM assembly is also little-endian only
        // (patches/misc/boringssl-target-cpus.patch).
        armeb: {
            cflags: [
                "-DOPENSSL_NO_ASM",
                "-DPNG_ARM_NEON_OPT=0",
            ],
            asflags: ["-DOPENSSL_NO_ASM"],
        },
        thumbeb: {
            cflags: [
                "-DOPENSSL_NO_ASM",
                "-DPNG_ARM_NEON_OPT=0",
            ],
            asflags: ["-DOPENSSL_NO_ASM"],
        },
        aarch64_be: {
            cflags: [
                "-DOPENSSL_NO_ASM",
                "-DPNG_ARM_NEON_OPT=0",
            ],
            asflags: ["-DOPENSSL_NO_ASM"],
        },
        // (BoringSSL is assembly-free on Windows upstream.)
        arm64ec: {
            cflags: ["-DPNG_ARM_NEON_OPT=0"],
        },
        // BoringSSL's x86-64 assembly assumes 64-bit pointers.
        x32: {
            cflags: [
                "-DOPENSSL_NO_ASM",
                "-DZSTD_DISABLE_ASM",
            ],
            asflags: ["-DOPENSSL_NO_ASM"],
        },
        // Older BoringSSL also has ppc64le assembly, which no Android.bp lists.
        powerpc64le: {
            cflags: [
                "-DOPENSSL_NO_ASM",
                "-DPNG_POWERPC_VSX_OPT=0",
            ],
            asflags: ["-DOPENSSL_NO_ASM"],
        },
        powerpc64: {
            cflags: ["-DPNG_POWERPC_VSX_OPT=0"],
        },
        loongarch64: {
            cflags: ["-DPNG_LOONGARCH_LSX_OPT=0"],
        },
    },
}
